{
  "name": "saucedemo-playwright-suite",
  "version": "1.0.0",
  "description": "Production-grade Playwright test automation for SauceDemo",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "format": "prettier --write .",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-plugin-playwright": "^2.11.0",
    "typescript": "^7.0.2"
  }
}
