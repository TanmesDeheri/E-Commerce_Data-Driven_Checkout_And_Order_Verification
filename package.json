{"name": "saucedemo-playwright-suite", "version": "1.0.0", "description": "Production-grade Playwright test automation for SauceDemo with Allure reporting", "type": "module", "scripts": {"test": "playwright test", "test:headed": "playwright test --headed", "allure:generate": "allure generate allure-results -o allure-report --clean", "allure:open": "allure open allure-report", "lint": "eslint .", "typecheck": "tsc --noEmit -p jsconfig.json", "format": "prettier --write .", "report": "playwright show-report"}, "devDependencies": {"@playwright/test": "^1.62.1", "@types/node": "^26.4.1", "allure-playwright": "^3.12.1", "eslint": "^10.9.1", "eslint-plugin-playwright": "^2.11.0", "typescript": "^7.0.2"}}